# Copy to .env and fill in what you have. Everything is optional:
# with no keys the app runs in Offline mode (exams, SRS, reading, listening, drills).

# AI teacher: anthropic | openai (OpenAI-compatible) | leave blank for auto-detect
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: Azure Speech (neural TTS + phoneme-level pronunciation scoring)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

PORT=3000
HOST=127.0.0.1
